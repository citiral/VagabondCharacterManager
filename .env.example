# Optional. Leave this unset to store the party in data/vagabond.sqlite.
# On Deno Deploy, assign the SQL database and this is injected for you.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Required. A long random string used to sign login tokens.
# AUTH_SECRET=

# This address is approved as soon as it registers, and can open /admin.
# Every other account stays pending until that person approves it.
# ADMIN_EMAIL=
